{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "env": ["DATABASE_URL", "BETTER_AUTH_SECRET", "BETTER_AUTH_URL", "ECCLESIA_SHOW_DEMO_LOGIN"],
      "outputs": [".next/**", "!.next/cache/**", "dist/**"]
    },
    "typecheck": {
      "dependsOn": ["^typecheck"]
    },
    "test": {
      "env": ["DATABASE_URL", "DATABASE_OWNER_URL"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    }
  }
}
