{
  "name": "ecclesia",
  "private": true,
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "turbo run dev --filter=@ecclesia/web",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "lint": "biome check .",
    "format": "biome check --write .",
    "db:generate": "pnpm --filter @ecclesia/db generate",
    "db:migrate": "pnpm --filter @ecclesia/db migrate",
    "db:seed": "pnpm --filter @ecclesia/db seed",
    "db:reset": "pnpm --filter @ecclesia/db reset",
    "check": "pnpm lint && pnpm typecheck && pnpm test"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.6",
    "turbo": "2.11.10",
    "typescript": "5.9.3"
  }
}
